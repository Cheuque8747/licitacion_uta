# Perfiles de Docker Compose
# Local (todos los servicios): all
# VM1: gateway,redis,monitoring
# VM2 y VM3: app
# VM4: db
COMPOSE_PROFILES=all

# Configuracion de Base de Datos PostgreSQL
DB_USER=admin_proyecto
DB_NAME=db_licitacion
DB_PASSWORD=tu_password_segura
DB_PORT=5432
DOCKER_DB_HOST=postgres-db
GATEWAY_DB_PORT=5433

# Configuracion de Redis
DOCKER_REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=tu_password_redis

# Puertos
PORT=3000
GATEWAY_PORT=8888

# Seguridad y Autenticacion
JWT_SECRET=tu_clave_secreta_jwt_aqui

# Integracion con Google Gemini
GEMINI_API_KEY=tu_api_key_de_google_gemini_aqui
